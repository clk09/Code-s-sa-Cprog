<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-703ce13b-2004-4817-8389-b12cd23c657f@mhtml.blink" />
  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101828">
  <title>Number Analysis System | CPROG 1</title>
  
</head>
<body>
  <div class="page">
    <header class="topbar">
      <div class="brand-mark" aria-hidden="true">#</div>
      <div>
        <p class="eyebrow">CPROG 1 · Chapter IV Activity</p>
        <h1>Number Analysis System</h1>
        <p class="subtitle">A simple interactive number toolkit.</p>
      </div>
    </header>

    <main class="layout">
      <aside class="panel menu" aria-label="Program menu">
        <h2 class="section-title">Main menu</h2>
        <nav class="menu-list">
          <button class="menu-button" type="button" data-tool="factorial" aria-pressed="false">
            <span class="menu-number">1</span><span class="menu-text"><strong>Calculate Factorial</strong><small>Find n!</small></span>
          </button>
          <button class="menu-button" type="button" data-tool="prime" aria-pressed="false">
            <span class="menu-number">2</span><span class="menu-text"><strong>Check Prime</strong><small>Test one number</small></span>
          </button>
          <button class="menu-button" type="button" data-tool="palindrome" aria-pressed="false">
            <span class="menu-number">3</span><span class="menu-text"><strong>Reverse &amp; Palindrome</strong><small>Reverse its digits</small></span>
          </button>
          <button class="menu-button" type="button" data-tool="range" aria-pressed="false">
            <span class="menu-number">4</span><span class="menu-text"><strong>Prime Number Range</strong><small>List primes in a range</small></span>
          </button>
          <button class="menu-button" type="button" data-tool="pyramid" aria-pressed="false">
            <span class="menu-number">5</span><span class="menu-text"><strong>Number Pyramid</strong><small>Print 1–9 rows</small></span>
          </button>
          <button class="menu-button" type="button" data-tool="exit" aria-pressed="false">
            <span class="menu-number">6</span><span class="menu-text"><strong>Exit</strong><small>End this session</small></span>
          </button>
        </nav>
        <p class="menu-note">Choose a feature to begin. All calculations run locally in your browser.</p>
      </aside>

      <section class="panel workspace" aria-live="polite" aria-atomic="true">
        <div class="workspace-head">
          <p class="workspace-kicker">Workspace</p>
          <h2 id="tool-title">Welcome</h2>
          <p class="description" id="tool-description">Select one of the six features from the main menu.</p>
        </div>
        <div class="workspace-body" id="workspace-body">
          <div class="welcome">
            <div class="welcome-icon" aria-hidden="true">∑</div>
            <p>This web version recreates the features of your C++ Number Analysis System with forms and on-screen results.</p>
            <div class="welcome-stats">
              <div class="stat"><strong>5</strong><span>Number tools</span></div>
              <div class="stat"><strong>1–9</strong><span>Pyramid rows</span></div>
              <div class="stat"><strong>0–20</strong><span>Factorial range</span></div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer>Number Analysis System · CPROG 1 · Runs in your browser, no installation required</footer>
  </div>

  


</body></html>
