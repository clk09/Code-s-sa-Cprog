@charset "utf-8";

:root { color-scheme: dark; --bg: #0b1020; --surface: #121a2e; --surface-2: #18233c; --line: #2a3855; --text: #edf3ff; --muted: #9eacc6; --accent: #7c9cff; --accent-2: #a78bfa; --good: #52d6a3; --bad: #ff8795; --radius: 18px; }

* { box-sizing: border-box; }

body { margin: 0px; min-height: 100vh; color: var(--text); background: radial-gradient(ellipse at 10% 0%, rgba(93, 119, 255, .18), transparent 38%),
        radial-gradient(ellipse at 100% 10%, rgba(167, 139, 250, .12), transparent 32%),
        var(--bg); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.5; }

.page { width: min(1120px, 100% - 32px); margin: 0px auto; padding: 36px 0px 48px; }

.topbar { display: flex; gap: 18px; align-items: center; margin-bottom: 28px; }

.brand-mark { width: 54px; height: 54px; flex: 0 0 auto; border-radius: 17px; display: grid; place-items: center; font-size: 25px; font-weight: 800; color: white; background: linear-gradient(135deg, var(--accent), var(--accent-2)); box-shadow: rgba(124, 156, 255, 0.22) 0px 12px 30px; }

.eyebrow { color: rgb(170, 186, 255); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.13em; text-transform: uppercase; margin: 0px 0px 4px; }

h1 { margin: 0px; font-size: clamp(1.55rem, 3vw, 2.25rem); letter-spacing: -0.04em; line-height: 1.15; }

.subtitle { margin: 8px 0px 0px; color: var(--muted); }

.layout { display: grid; grid-template-columns: minmax(265px, 0.82fr) minmax(0px, 1.6fr); gap: 20px; align-items: start; }

.panel { border: 1px solid var(--line); border-radius: var(--radius); background: rgba(18, 26, 46, 0.92); box-shadow: rgba(0, 0, 0, 0.16) 0px 18px 55px; }

.menu { padding: 19px; }

.section-title { margin: 0px 0px 13px; font-size: 0.95rem; }

.menu-list { display: grid; gap: 9px; }

.menu-button { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; padding: 12px; border: 1px solid transparent; border-radius: 13px; color: var(--text); background: transparent; cursor: pointer; font: inherit; transition: border-color 0.15s, background 0.15s, transform 0.15s; }

.menu-button:hover { background: rgba(124, 156, 255, 0.08); border-color: var(--line); }

.menu-button:focus-visible, input:focus-visible, .primary:focus-visible, .secondary:focus-visible { outline: rgba(124, 156, 255, 0.55) solid 3px; outline-offset: 2px; }

.menu-button.active { background: linear-gradient(100deg, rgba(124, 156, 255, 0.18), rgba(167, 139, 250, 0.08)); border-color: rgba(124, 156, 255, 0.42); }

.menu-number { display: grid; place-items: center; width: 35px; height: 35px; flex: 0 0 auto; border-radius: 10px; background: var(--surface-2); color: rgb(199, 210, 255); font-weight: 800; }

.menu-button.active .menu-number { color: white; background: linear-gradient(135deg, var(--accent), var(--accent-2)); }

.menu-text { display: grid; gap: 2px; }

.menu-text strong { font-size: 0.9rem; font-weight: 700; }

.menu-text small { color: var(--muted); font-size: 0.76rem; }

.menu-note { margin: 17px 3px 0px; color: var(--muted); font-size: 0.79rem; }

.workspace { min-height: 470px; overflow: hidden; }

.workspace-head { padding: 25px 26px 20px; border-bottom: 1px solid var(--line); background: linear-gradient(110deg, rgba(124, 156, 255, 0.07), transparent 68%); }

.workspace-kicker { color: rgb(170, 186, 255); text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem; font-weight: 800; margin: 0px 0px 7px; }

h2 { margin: 0px; font-size: clamp(1.35rem, 2.7vw, 1.8rem); letter-spacing: -0.03em; }

.description { margin: 8px 0px 0px; color: var(--muted); }

.workspace-body { padding: 25px 26px 27px; }

.form-grid { display: grid; grid-template-columns: minmax(0px, 1fr) auto; gap: 12px; align-items: end; }

.field { display: grid; gap: 8px; }

label { color: rgb(219, 229, 250); font-size: 0.9rem; font-weight: 650; }

input[type="number"] { width: 100%; min-height: 47px; padding: 11px 13px; border: 1px solid rgb(58, 74, 107); border-radius: 11px; background: rgb(11, 18, 35); color: var(--text); font: inherit; }

input[type="number"]::placeholder { color: rgb(111, 126, 156); }

.primary, .secondary { min-height: 47px; border-radius: 11px; padding: 11px 17px; cursor: pointer; font-style: inherit; font-variant: inherit; font-stretch: inherit; font-size: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-weight: 750; transition: transform 0.15s, filter 0.15s; }

.primary { color: rgb(255, 255, 255); border: 0px; background: linear-gradient(135deg, rgb(104, 137, 255), rgb(155, 124, 244)); box-shadow: rgba(104, 137, 255, 0.18) 0px 8px 22px; }

.secondary { color: var(--text); border: 1px solid var(--line); background: var(--surface-2); }

.primary:hover, .secondary:hover { filter: brightness(1.08); transform: translateY(-1px); }

.result { margin-top: 22px; padding: 17px; border: 1px solid var(--line); border-radius: 13px; background: rgb(12, 20, 38); }

.result-title { display: flex; gap: 8px; align-items: center; margin: 0px 0px 8px; color: var(--muted); font-size: 0.77rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }

.result-title::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }

.result-content { margin: 0px; overflow-wrap: anywhere; white-space: pre-wrap; font-size: 1.02rem; }

.result-content.success { color: var(--good); }

.result-content.pyramid-output { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace; white-space: pre; overflow-x: auto; line-height: 1.45; font-size: 1.12rem; }

.result-content.error { color: var(--bad); }

.hint { margin: 15px 0px 0px; color: var(--muted); font-size: 0.82rem; }

.welcome { display: grid; gap: 18px; }

.welcome-icon { font-size: 2.2rem; }

.welcome p { color: var(--muted); margin: 0px; }

.welcome-stats { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 10px; margin-top: 5px; }

.stat { padding: 15px 13px; border: 1px solid var(--line); border-radius: 13px; background: rgba(24, 35, 60, 0.72); }

.stat strong { display: block; font-size: 1.35rem; }

.stat span { color: var(--muted); font-size: 0.78rem; }

.exit-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; }

footer { margin-top: 20px; color: rgb(127, 141, 170); text-align: center; font-size: 0.77rem; }

@media (max-width: 760px) {
  .page { width: min(100% - 22px, 590px); padding-top: 24px; }
  .layout { grid-template-columns: 1fr; }
  .menu { padding: 15px; }
  .menu-list { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
  .menu-button { gap: 9px; padding: 10px; }
  .menu-text strong { font-size: 0.82rem; }
  .menu-text small { font-size: 0.7rem; }
  .menu-number { width: 31px; height: 31px; }
  .workspace { min-height: 0px; }
  .workspace-head { padding: 21px 19px 17px; }
  .workspace-body { padding: 20px 19px 23px; }
  .form-grid { grid-template-columns: 1fr; }
  .primary { width: 100%; }
  .welcome-stats { grid-template-columns: 1fr; }
  .stat { display: flex; justify-content: space-between; align-items: center; }
}

@media (max-width: 390px) {
  .topbar { align-items: flex-start; }
  .brand-mark { width: 44px; height: 44px; border-radius: 13px; }
  .menu-list { grid-template-columns: 1fr; }
}
